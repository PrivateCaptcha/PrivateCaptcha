#!/usr/bin/env bash
set -euo pipefail

STAGED_GO_FILES=()
while IFS= read -r f; do
  STAGED_GO_FILES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' | grep -v '^vendor/' || true)

# macOS ships bash 3.2 which lacks mapfile/readarray.
#mapfile -t STAGED_GO_FILES < <(
#  git diff --cached --name-only --diff-filter=ACM | grep '\.go$' | grep -v '^vendor/' || true
#)

if [ ${#STAGED_GO_FILES[@]} -eq 0 ]; then
  exit 0
fi

FORMATTER="gofmt"
if command -v goimports >/dev/null 2>&1; then
  FORMATTER="goimports"
fi

UNFORMATTED=$( $FORMATTER -l "${STAGED_GO_FILES[@]}" )
if [ -n "$UNFORMATTED" ]; then
    echo "The following files require formatting:"
    echo "$UNFORMATTED"
    exit 1
fi

mapfile -t PACKAGES < <(
  printf "%s\n" "${STAGED_GO_FILES[@]}" \
    | xargs -n1 dirname \
    | sort -u \
    | sed 's|^|./|'
)
if ! go vet -tags 'enterprise' $PACKAGES; then
    echo "'go vet' failed"
    exit 1
fi

exit 0
