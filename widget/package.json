{
  "name": "widget",
  "version": "1.0.0",
  "main": "./static/js/privatecaptcha.js",
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "esbuild-plugin-inline-worker": "^0.1.1",
    "eslint": "^9.23.0",
    "happy-dom": "^20.0.2"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:puzzle-compat": "esbuild solve-puzzles.js --bundle --platform=node --format=esm --loader:.wasm=base64 --outfile=../bin/puzzle-compat-solver.mjs",
    "test": "node esbuild.test.config.mjs && node --test test/bundle.test.js",
    "lint": "eslint js/**/*.js",
    "bundle:measure": "node measure-bundle.mjs",
    "bundle:analyze": "node analyze-bundle.mjs"
  },
  "dependencies": {
    "base64-arraybuffer": "^1.0.2",
    "blakejs": "^1.2.1"
  }
